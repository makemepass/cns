#include <stdio.h>
#include <ctype.h>
#include <string.h>
int main() {
    char t[50], k[10];
    int c, i, j = 0, p, q;
    printf("1.Encrypt 2.Decrypt: ");
    scanf("%d", &c);
    printf("Text: "); scanf("%s", t);
    printf("Key: ");  scanf("%s", k);
    printf("Result: ");
    for(i = 0; t[i]; i++, j = (j + 1) % strlen(k)) {
        p = toupper(t[i]) - 65;
        q = toupper(k[j]) - 65;
        printf("%c", ((c == 1 ? (p + q) : (p - q + 26)) % 26) + 65);
    }
    printf("\n");
    return 0;
}
