#include <stdio.h>
int main() {
    int mat[3][3] = { { 3, 0, 0 },{ 0, 3, 0 },{ 0, 0, 3 } };
    int inv_mat[3][3] = { { 9, 0, 0 },{ 0, 9, 0 },{ 0, 0, 9 } };
    printf("Enter msg: ");
    char str[4], enc[4], dec[4];
    scanf("%3s", str);
    for (int i = 0; i < 3; i++) {
        str[i] -= 'A';
    }
    for (int i = 0; i < 3; i++) {
        int elem = 0;
        for (int j = 0; j < 3; j++) {
            elem += (mat[i][j] * str[j]);
        }
        enc[i] = (elem % 26);
    }
    for (int i = 0; i < 3; i++) {
        enc[i] += 'A';
    }
    printf("Encyrpted: %s\n", enc);
    for (int i = 0; i < 3; i++) {
        enc[i] -= 'A';
    }
    for (int i = 0; i < 3; i++) {
        int elem = 0;
        for (int j = 0; j < 3; j++) {
            elem += (inv_mat[i][j] * enc[j]);
        }
        dec[i] = (elem % 26);
    }
    for (int i = 0; i < 3; i++) {
        dec[i] += 'A';
    }
    printf("Decrypted: %s", dec);
}
