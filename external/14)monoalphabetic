#include <stdio.h>
#include <string.h>
void main() {
    char plain[] = "abcdefghijklmnopqrstuvwxyz";
    char cipher[] = "qwertyuiopasdfghjklzxcvbnm";
    char text[100];
    printf("enter text: ");
    scanf("%s", text);
    for (int i = 0; i < strlen(text); i++) {
        for (int j = 0; j < 26; j++) {
            if (text[i] == plain[j]) {
                text[i] = cipher[j];
                break;
            }
        }
    }
    printf("Encrypted: %s\n", text);
}
