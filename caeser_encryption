#include<stdio.h>
#include<string.h>
#include<ctype.h>
void main()
{
    int i, key;
    char text[100]; 
    printf("\nCaesar Cipher - Encryption");
    printf("\nEnter Message To Encrypt : ");
    fgets(text, sizeof(text), stdin);
    printf("Enter Key : ");
    scanf("%d", &key);
    for(i=0; text[i]!='\0'; ++i)
    {
        if(text[i] >= 'a' && text[i] <= 'z')
        {
            text[i] = text[i] + key;
            if(text[i] > 'z')
            {
                text[i] = text[i] - 'z' + 'a' - 1;
            }
        }
        else if(text[i] >= 'A' && text[i] <= 'Z')
        {
            text[i] = text[i] + key;
            if(text[i] > 'Z')
            {
                text[i] = text[i] - 'Z' + 'A' - 1;
            }
        }
    }
    printf("\nEncrypted Message : %s\n", text);
}
